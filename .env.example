# ============================================================
#  Wroclaw Flats Monitor - konfiguracja
#  Skopiuj do .env:  cp .env.example .env
# ============================================================

# --- Baza danych ---
# SQLite (domyślnie). Przejście na Postgres: postgresql+psycopg://user:pass@host:5432/flats
DATABASE_URL=sqlite:///./data/flats.db

# --- Serwer ---
HOST=127.0.0.1
PORT=8000

# --- Scheduler ---
# Co ile minut odpalać pełny cykl scrapowania
SCRAPE_INTERVAL_MINUTES=15
# Uruchamiać scheduler razem z API? (0 = tylko API, scrapowanie ręczne/cron)
SCHEDULER_ENABLED=1
# Zrobić pierwszy przebieg od razu po starcie
RUN_ON_STARTUP=0

# --- Które źródła są aktywne (przecinkami) ---
# Dostępne: olx, otodom, nieruchomosci_online, morizon, developer_generic, facebook_group
ENABLED_SOURCES=olx,otodom,nieruchomosci_online,morizon

# --- Anty-blokowanie ---
# Minimalna/maksymalna przerwa między requestami do TEGO SAMEGO hosta (sekundy)
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=4.0
# Maksymalna liczba stron listingu pobieranych z jednego źródła w jednym cyklu
MAX_PAGES_PER_SOURCE=3
# Timeout HTTP (sekundy)
HTTP_TIMEOUT=25
# Opcjonalny proxy, np. http://user:pass@host:port  (puste = bez proxy)
HTTP_PROXY=

# --- Telegram ---
# 1) Napisz do @BotFather -> /newbot -> dostajesz token
# 2) Napisz cokolwiek do swojego bota, potem otwórz:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  -> odczytaj "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Możesz podać kilka chat_id po przecinku (Ty + małżonka):
# TELEGRAM_CHAT_ID=123456789,987654321

# --- Discord (opcjonalnie) ---
DISCORD_WEBHOOK_URL=

# --- E-mail (opcjonalnie) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Powiadomienia: bezpieczniki ---
# Maks. liczba powiadomień wysłanych w jednym cyklu (chroni przed zalewem przy 1. uruchomieniu)
MAX_NOTIFICATIONS_PER_RUN=15
# Pierwszy przebieg tylko wypełnia bazę, bez wysyłki alertów
SILENT_FIRST_RUN=1

# --- Deduplikacja ---
# Próg podobieństwa (0-1), powyżej którego dwie oferty uznajemy za to samo mieszkanie
DEDUP_THRESHOLD=0.82

# --- Filtr miasta ---
# Odrzuca oferty, które nie potwierdzają, że pochodzą z Wrocławia. Chroni przed
# sytuacją, w której portal zwróci wyniki z całej Polski — mieszkanie z tańszego
# miasta wyglądałoby wtedy jak wielka okazja względem wrocławskiej mediany.
# Ustaw 0 tylko, jeśli świadomie chcesz zbierać oferty z innych miast.
STRICT_CITY_FILTER=1

# --- Okazje ---
# O ile % poniżej mediany ceny za m2 w dzielnicy, żeby oznaczyć jako okazję
DEAL_DISCOUNT_PCT=12
